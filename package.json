{
  "name": "chopsticks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "筷子：让大肥鱼更方便地吃白饭。持续感知、统一经历、事件驱动的 DSH Agent。",
  "engines": {
    "node": ">=24.0.0"
  },
  "main": "./dist/src/host/index.mjs",
  "exports": {
    ".": "./dist/src/host/index.mjs",
    "./guard": "./dist/src/host/guard.mjs",
    "./client": "./dist/src/console/client.js"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./presets/runtime.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test.mts",
    "test:audit": "npm test",
    "release": "node scripts/build.mts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "js-yaml": "^4.3.2",
    "playwright-core": "1.56.1",
    "qrcode": "1.5.4",
    "ws": "^8.18.0",
    "zod": "^4.4.3"
  },
  "license": "GPL-3.0-only",
  "devDependencies": {
    "@types/js-yaml": "4.0.9",
    "@types/node": "24.19.2",
    "@types/qrcode": "1.5.6",
    "@types/ws": "8.18.2",
    "typescript": "5.9.3"
  }
}
