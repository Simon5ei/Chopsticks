import test from 'node:test';
import assert from 'node:assert/strict';
import {createDevelopment} from '../src/host/development.mjs';
const fixture=()=>{const values=new Map(),events=new Map(),bindings=new Map(),workers=new Map(),tasks=new Map();const config={development:{enabled:true,workspace:'.'},qq:{ownerId:'owner'}};let n=0;const state={get:(k?: any,id?: any)=>values.get(k+id),put:(k?: any,id?: any,v?: any)=>values.set(k+id,structuredClone(v)),binding:(id)=>bindings.get(id)};const coordinator={submit:async(c?: any,a?: any)=>{const t={id:'task'+(++n)};tasks.set(t.id,t);return t;},getWorkerContext:(id)=>workers.get(id),follow:async()=>true,stop:async()=>true};const development=createDevelopment({config,state,store:{get:(id)=>events.get(id)},getCoordinator:()=>coordinator});const bind=(id?: any,actorId: string='owner',kind: string='message.received',channel: string='g:1')=>{events.set(id,{id,actorId,kind,channel,text:'RAW '+id});bindings.set('chat',{eventId:id,actorId,channel,admin:true,consumed:true});};return {development,config,state,events,bindings,workers,bind};};
test('canonical owner grants preserve original source across newer consumed bindings and restart',async()=>{const f=fixture();f.bind('original');const task=await f.development.develop('chat',{prompt:'summary',requestId:'call'});f.workers.set('worker',{active:true,ticketId:task.id,chatKey:'g:1',role:'worker'});f.bind('later','other');assert.equal(f.development.authorize('worker').originalRequest,'RAW original');assert.throws(()=>f.development.control('chat',task.id),/owner|administrator/i);f.config.qq.ownerId='changed';assert.throws(()=>f.development.authorize('worker'),/owner|administrator/i);});
test('forged admin, Bili, result sources, changed binding and disabled config cannot develop',async()=>{for(const [actor,kind,channel]of [['other','message.received','g:1'],['owner','task.result','g:1'],['owner','message.received','bili:public']]){const f=fixture();f.bind('source',actor,kind,channel);await assert.rejects(f.development.develop('chat',{prompt:'do',requestId:'call'}),/owner|administrator|QQ/i);}const f=fixture();f.bind('source');f.bindings.get('chat').actorId='forged';await assert.rejects(f.development.develop('chat',{prompt:'do',requestId:'call'}));f.bind('valid');f.config.development.enabled=false;await assert.rejects(f.development.develop('chat',{prompt:'do',requestId:'call'}));});
test('old research workers and inactive granted workers never authorize commands',async()=>{const f=fixture();f.workers.set('old',{active:true,ticketId:'old',chatKey:'g:1'});assert.throws(()=>f.development.authorize('old'));f.bind('source');const task=await f.development.develop('chat',{prompt:'do',requestId:'call'});f.workers.set('worker',{active:false,ticketId:task.id,chatKey:'g:1'});assert.throws(()=>f.development.authorize('worker'));});

import fs from 'node:fs';
import os from 'node:os';
import path from 'node:path';
import {createDshExecutor} from '../src/tasks/dsh-executor.mjs';
test('trusted development resolver selects dedicated preset and includes raw request',async()=>{const root=fs.mkdtempSync(path.join(os.tmpdir(),'dev-preset-'));let created,prompt;const executor=createDshExecutor({workerRoot:root,resolveWorker:()=>({mode:'development',originalRequest:'RAW ADMIN INSTRUCTION'}),controller:{inspect:async()=>{throw {code:'session/not-found'};},create:async (a?: any) =>(created=a,{sessionId:a.sessionId}),prompt:async (a?: any) =>(prompt=a,{accepted:true})}});try{await executor.ensureSession({sessionId:'worker'});await executor.prompt({sessionId:'worker',text:'MODEL SUMMARY',deliveryId:'prompt:1'});assert.equal(created.agentPreset,'chopsticks-development-worker');assert.match(prompt.content[0].text,/RAW ADMIN INSTRUCTION/);assert.match(prompt.content[0].text,/MODEL SUMMARY/);}finally{fs.rmSync(root,{recursive:true,force:true});}});

import {createRuntime} from '../src/host/runtime.mjs';
import {setTimeout as delay} from 'node:timers/promises';
async function runtimeFixture(t?: any){const root=fs.mkdtempSync(path.join(os.tmpdir(),'dev-runtime-'));const fishHome=path.join(root,'fish'),stateDir=path.join(root,'state');fs.mkdirSync(path.join(fishHome,'characters','fish'),{recursive:true});fs.writeFileSync(path.join(fishHome,'characters','current.json'),JSON.stringify({id:'fish'}));const deliveries=[],created=[];let runtime;const controller={inspect:async (id?: any) =>{if(!created.some((c)=>c.sessionId===id))throw {code:'session/not-found'};return {sessionId:id};},create:async (a?: any) =>(created.push(a),{sessionId:a.sessionId}),resolveAgent:async()=>{},prompt:async (a?: any) =>{if(a.sessionId.startsWith('chopsticks-router-')){const events=JSON.parse(a.content[0].text.split('待判断事件：\n')[1]);queueMicrotask(()=>runtime.decide(a.sessionId,JSON.stringify(events.map((e)=>({eventId:e.id,kind:e.actorId==='owner'?'task':'respond',prompt:'model intent'})))));}else deliveries.push(a);return {accepted:true};},cancel:async()=>{},updateQueue:async()=>{}};const config={stateDir,fishHome,qq:{enabled:false,ownerId:'owner'},development:{enabled:true,workspace:root},bili:{enabled:false}};const create=async()=>{runtime=await createRuntime({config,controller,adapterFactory:()=>({start:async()=>{},close:async()=>{}})});await runtime.start();return runtime;};await create();t.after(async()=>{await runtime.close();fs.rmSync(root,{recursive:true,force:true});});const wait=async (fn?: any) =>{for(let i=0;i<200;i++){if(fn())return;await delay(10);}assert.fail('fixture timed out');};const incoming=async(id?: any,actorId: string='owner')=>{await runtime.ingest({id,kind:'message.received',channel:'g:1',actorId,text:'RAW '+id,meta:{addressed:true,admin:true}});await wait(()=>deliveries.some((d)=>!d.sessionId.startsWith('chopsticks-worker-')&&d.content[0].text.includes(`"id":"${id}"`)));const delivery=deliveries.filter((d)=>!d.sessionId.startsWith('chopsticks-worker-')).at(-1);return delivery;};const consume=(d)=>runtime.event({id:d.sessionId},{type:'user/message',data:{source:{rpcId:d.requestId}}});return {get runtime(){return runtime;},config,deliveries,created,incoming,consume,wait,create};}
test('runtime dispatches owner machine task to reception; only consumed owner input grants dedicated worker',async (t?: any) =>{const f=await runtimeFixture(t);const d=await f.incoming('create-directory');assert.ok(!d.sessionId.startsWith('chopsticks-worker-'));await assert.rejects(f.runtime.develop(d.sessionId,{prompt:'create',requestId:'dev-call'}),/consumed/);f.consume(d);const task=await f.runtime.develop(d.sessionId,{prompt:'create',requestId:'dev-call'});assert.equal((await f.runtime.develop(d.sessionId,{prompt:'create',requestId:'dev-call'})).id,task.id);await f.wait(()=>f.created.some((c)=>c.agentPreset==='chopsticks-development-worker'));const worker=f.created.find((c)=>c.agentPreset==='chopsticks-development-worker').sessionId;await f.wait(()=>f.deliveries.some((d)=>d.sessionId===worker));assert.equal(f.runtime.development.authorize(worker).ticketId,task.id);assert.match(f.deliveries.find((d)=>d.sessionId===worker).content[0].text,/RAW create-directory/);const other=await f.incoming('malicious-stop','other');f.consume(other);await assert.rejects(f.runtime.coordinator.follow(f.runtime.caller(other.sessionId),task.id,'do more'),/owner|administrator/);await assert.rejects(f.runtime.coordinator.stop(f.runtime.caller(other.sessionId),task.id),/owner|administrator/);assert.equal(f.runtime.development.authorize(worker).eventId,'create-directory');const owner=await f.incoming('owner-stop');f.consume(owner);await f.runtime.coordinator.stop(f.runtime.caller(owner.sessionId),task.id);assert.throws(()=>f.runtime.development.authorize(worker),/inactive|grant/);});
test('persisted grant survives runtime restart without giving old reading task command rights',async (t?: any) =>{const f=await runtimeFixture(t);const d=await f.incoming('restart-request');f.consume(d);const task=await f.runtime.develop(d.sessionId,{prompt:'create',requestId:'dev-call'});await f.wait(()=>f.created.some((c)=>c.agentPreset==='chopsticks-development-worker'));const worker=f.created.find((c)=>c.agentPreset==='chopsticks-development-worker').sessionId;const grant=f.runtime.development.authorize(worker);await f.runtime.close();await f.create();assert.deepEqual(f.runtime.state.get('development-grant',task.id),grant);assert.throws(()=>f.runtime.development.authorize('chopsticks-worker-old'));assert.equal(f.runtime.state.get('task-source',task.id).eventId,'restart-request');});

test('read-only task request IDs cannot be upgraded to development grants',async (t?: any) =>{const f=await runtimeFixture(t);const d=await f.incoming('old-request');f.consume(d);const prompt='create';const original='RAW old-request';const task=await f.runtime.coordinator.submit(f.runtime.caller(d.sessionId),{requestId:'same-call',prompt:`管理员要求：\n${original}\n任务摘要：\n${prompt}`});await assert.rejects(f.runtime.develop(d.sessionId,{prompt,requestId:'same-call'}),/read-only/);assert.equal(f.runtime.state.get('development-grant',task.id),undefined);});
test('verified owner follow-up is persisted and included as additional authorized request',async (t?: any) =>{const f=await runtimeFixture(t);const d=await f.incoming('first-request');f.consume(d);const task=await f.runtime.develop(d.sessionId,{prompt:'create',requestId:'dev-call'});await f.wait(()=>f.created.some((c)=>c.agentPreset==='chopsticks-development-worker'));const worker=f.created.find((c)=>c.agentPreset==='chopsticks-development-worker').sessionId;const next=await f.incoming('new-owner-requirement');f.consume(next);await f.runtime.coordinator.follow(f.runtime.caller(next.sessionId),task.id,'summary');assert.match(f.runtime.development.resolveWorker(worker).originalRequest,/RAW new-owner-requirement/);assert.equal(f.runtime.state.get('development-grant',task.id).authorizedRequests[0].eventId,'new-owner-requirement');});
