import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
import {createEventStore} from '../src/core/events.mjs';
import {createHostState} from '../src/host/state.mjs';
import {createPlatformSessions} from '../src/host/platform-sessions.mjs';
import {platformRoute} from '../src/core/platforms.mjs';
import {apply as guard} from '../src/host/guard.mjs';
let module;try{module=await import('../src/host/evolution.mjs');}catch(e){if(e.code!=='ERR_MODULE_NOT_FOUND')throw e;}
const flush=()=>new Promise<any | void>((r)=>setImmediate(r));
function fixture(t?: any){assert.ok(module,'evolution implementation missing');const dir=fs.mkdtempSync(path.join(os.tmpdir(),'evolution-')),store=createEventStore({stateDir:dir}),state=createHostState(store),calls=[];let time=1000000,health={ready:true};const sessions=createPlatformSessions({state,characterId:'fish',now:()=>time,ensure:async()=>{},execute:async (x?: any) =>{state.bind(x.sessionId,{...x.binding,role:'evolution',scope:x.event.meta.scope});calls.push(x);}});const opts={state,store,sessions,caller:(id)=>({...state.binding(id),sessionId:id}),snapshot:()=>health,now:()=>time,config:{reviewIntervalMs:60000}};const evo=module.createEvolution(opts);t.after(async()=>{await evo.close();await sessions.close();store.close();fs.rmSync(dir,{recursive:true,force:true});});return {evo,opts,sessions,store,state,calls,set time(x: any){time=x},set health(x: any){health=x}};}
const add=(f?: any,id?: any,channel: string='p:42',kind: string='message.received',meta: Record<string, any>={})=>f.store.append({id,channel,kind,actorId:'42',text:'实际聊了茶',meta});
const saveAll=async (f?: any) =>{await f.sessions.start();await flush();for(const c of [...f.calls]){if(f.state.get('platform-job',c.action.dispatchId)?.status!=='starting')continue;consume(f,c);f.evo.report(c.sessionId,report(c,c.event.meta.sourceEventIds[0]));f.sessions.event(c.sessionId,{type:'turn/end'});}};
const consume=(f?: any,call?: any)=>f.sessions.event(call.sessionId,{type:'user/message',data:{source:{rpcId:call.action.dispatchId}}});
const report=(call?: any,id?: any)=>({scope:call.event.meta.scope,facts:[{text:'聊了茶',sourceEventIds:[id]}],hypotheses:[{text:'可能喜欢茶，待确认',sourceEventIds:[id]}],relationships:[]});

test('social review excludes content comments before inference and publishes a durable graph after saving',async (t?: any) =>{
 const f=fixture(t);add(f,'group','g:1');add(f,'comment','bili:public');add(f,'dm','bili:dm:42');add(f,'feed','qzone:friends');
 await f.sessions.start();await f.evo.start();await flush();
 const turns=f.state.list('evolution-turn').filter((r)=>r.kind==='social');
 assert.deepEqual(turns.flatMap((t)=>t.sourceEventIds).sort(),['dm','group']);
 const c=f.calls.find((c)=>c.event.channel==='evolution:social');assert.ok(c);consume(f,c);
 f.state.put('evolution-report','old-comment',{id:'old-comment',kind:'social',scope:'public',sourceEventIds:['comment'],createdAt:0,facts:[{text:'comment history',sourceEventIds:['comment']}],hypotheses:[],relationships:[]});
 assert.ok(!f.evo.read(c.sessionId).reports.some((r)=>r.id==='old-comment'));
 const id=c.event.meta.sourceEventIds[0],input=report(c,id);input.relationships=[{from:'42',to:'fish',relation:'聊过茶',certainty:'observed',sourceEventIds:[id]}];
 f.evo.report(c.sessionId,input);assert.equal(f.evo.relationships.get().edges.length,1);
 assert.equal(f.state.get('relationship-graph','current').revision,1);
 f.evo.report(c.sessionId,input);assert.equal(f.evo.relationships.get().revision,1);
});
test('one native evolution workspace contains three reviewers and one scoped diary session',async (t?: any) =>{const f=fixture(t);await f.evo.start();const rows=f.state.list('platform-session');assert.deepEqual(rows.map((r)=>r.key).sort(),['evolution.diary','evolution.reflection','evolution.social','evolution.watchdog']);assert.ok(rows.every((r)=>r.workspace==='evolution'));assert.equal(platformRoute('diary:public').sessionKey,platformRoute('diary:private:qq').sessionKey);assert.equal(platformRoute('diary:private:qq').scope,'private:qq');});
test('reports require consumed active internal binding and canonical same-scope source IDs',async (t?: any) =>{const f=fixture(t);add(f,'private');add(f,'plan','p:42','timer');await f.sessions.start();await f.evo.start();await flush();add(f,'public','g:1');const c=f.calls.find((c)=>c.event.channel==='evolution:reflection'&&c.event.meta.scope==='private:qq');assert.ok(c);const input=report(c,'private');assert.throws(()=>f.evo.report(c.sessionId,input));consume(f,c);assert.throws(()=>f.evo.report(c.sessionId,{...input,scope:'public'}));assert.throws(()=>f.evo.report(c.sessionId,report(c,'public')));assert.throws(()=>f.evo.report(c.sessionId,report(c,'plan')));assert.throws(()=>f.evo.report(c.sessionId,report(c,'unknown')));const saved=f.evo.report(c.sessionId,input);assert.equal(saved.scope,'private:qq');assert.equal(f.evo.report(c.sessionId,input).id,saved.id);assert.throws(()=>f.evo.report(c.sessionId,{...input,facts:[{text:'changed',sourceEventIds:['private']}]}));assert.equal(f.evo.read(c.sessionId).reports.length,1);f.state.bind('external',{...f.state.binding(c.sessionId),role:'qq'});assert.throws(()=>f.evo.read('external'));const ac=new AbortController();ac.abort();assert.throws(()=>f.evo.report(c.sessionId,input,ac.signal));f.sessions.event(c.sessionId,{type:'turn/end'});assert.throws(()=>f.evo.report(c.sessionId,input));assert.equal(f.state.list('evolution-report').length,1);});
test('cadence and durable watermark exclude plans and internal reports and survive restart',async (t?: any) =>{const f=fixture(t);add(f,'private');add(f,'plan','g:1','timer');await f.evo.start();await saveAll(f);const count=f.state.list('platform-job').length;assert.equal(count,3);await f.evo.poll();assert.equal(f.state.list('platform-job').length,count);add(f,'next');await f.evo.poll();assert.equal(f.state.list('platform-job').length,count);f.time=1060001;await f.evo.poll();assert.equal(f.state.list('platform-job').length,count+2);const restarted=module.createEvolution(f.opts);await restarted.start();assert.equal(f.state.list('platform-job').length,count+2);await restarted.close();});
test('watchdog snapshots exclude credentials and body text and only changed health is queued',async (t?: any) =>{const f=fixture(t);f.health={ready:true,token:'secret',text:'private body',qq:{state:'ready',lastAt:123,token:'qq-secret'}};await f.evo.start();await saveAll(f);const before=f.state.list('platform-job').filter((j)=>j.key==='evolution.watchdog');assert.equal(before.length,1);const text=JSON.stringify(before);assert.doesNotMatch(text,/secret|private body|lastAt/);f.time=1060001;f.health={ready:true,token:'other',qq:{state:'ready',lastAt:999}};await f.evo.poll();assert.equal(f.state.list('platform-job').filter((j)=>j.key==='evolution.watchdog').length,1);f.health={ready:false,qq:{state:'error'}};await f.evo.poll();assert.equal(f.state.list('platform-job').filter((j)=>j.key==='evolution.watchdog').length,2);});
test('internal presets reject all external actor tools, shell and desktop',()=>{for(const mode of ['evolution','diary']){let check;const visible=new Map(['chopsticks_evolution_read','chopsticks_evolution_report','chopsticks_diary_write','chopsticks_diary_read','chopsticks_diary_search','chopsticks_send','chopsticks_exec','chopsticks_develop','mcp__cul__click','mcp__qq__qq_write','chopsticks_remember'].map((n)=>[n,{}]));guard({tools:{view:()=>({visible}),restrict:()=>()=>{},guard:(fn)=>check=fn},on(){},effect(){}},{mode});for(const name of ['chopsticks_send','chopsticks_exec','chopsticks_develop','mcp__cul__click','mcp__qq__qq_write','chopsticks_remember'])assert.ok(check({name}),`${mode} permits ${name}`);assert.equal(check({name:mode==='evolution'?'chopsticks_evolution_report':'chopsticks_diary_write'}),undefined);}});
test('watchdog includes recorded operation failures without targets or authentication secrets',()=>{assert.ok(module);assert.deepEqual(module.evolutionSnapshot({issues:[{platform:'douyin',operation:'detail',state:'partial',code:'empty_detail',warningCount:1,accountId:'private',text:'body',cookie:'secret'}]}),{issues:[{platform:'douyin',operation:'detail',state:'partial',code:'empty_detail',warningCount:1}]});});

test('reportless turn stays incomplete across restart and gets only one delayed same-source retry',async (t?: any) =>{const f=fixture(t);add(f,'real');await f.sessions.start();await f.evo.start();await flush();const c=f.calls.find((x)=>x.event.channel==='evolution:reflection');consume(f,c);f.sessions.event(c.sessionId,{type:'turn/end'});await f.evo.poll();assert.equal(f.state.get('evolution-cursor','reflection:private:qq')?.seq||0,0);assert.equal(f.state.get('evolution-turn',c.action.dispatchId).status,'incomplete');const count=f.state.list('platform-job').length;await f.evo.poll();assert.equal(f.state.list('platform-job').length,count);await f.evo.close();const restarted=module.createEvolution(f.opts);await restarted.start();assert.equal(f.state.list('platform-job').length,count);f.time=1060001;await restarted.poll();await flush();const next=f.calls.filter((x)=>x.event.channel==='evolution:reflection').at(-1);assert.notEqual(next.action.dispatchId,c.action.dispatchId);assert.deepEqual(next.event.meta.sourceEventIds,['real']);consume(f,next);f.sessions.event(next.sessionId,{type:'turn/end'});await restarted.poll();f.time=2000000;await restarted.poll();assert.equal(f.state.list('platform-job').filter((x)=>x.key==='evolution.reflection').length,2);assert.equal(f.state.get('evolution-turn',next.action.dispatchId).status,'attention_required');assert.equal(f.state.list('evolution-report').length,0);add(f,'new-real');await restarted.poll();await flush();assert.equal(f.state.list('platform-job').filter((x)=>x.key==='evolution.reflection').length,3);const fresh=f.calls.filter((x)=>x.event.channel==='evolution:reflection').at(-1);consume(f,fresh);restarted.report(fresh.sessionId,report(fresh,'new-real'));assert.equal(f.state.get('evolution-cursor','reflection:private:qq').seq,f.store.get('new-real').seq);assert.equal(f.state.list('evolution-report').length,1);await restarted.close();});
