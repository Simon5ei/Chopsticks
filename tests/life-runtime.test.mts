import test from 'node:test';
import assert from 'node:assert/strict';
import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
import {createEventStore} from '../src/core/events.mjs';import {createHostState} from '../src/host/state.mjs';import {createDiary} from '../src/host/diary.mjs';import {createLifeRuntime} from '../src/host/life-runtime.mjs';
function fixture(t?: any,channel: string='p:42') {const dir=fs.mkdtempSync(path.join(os.tmpdir(),'life-runtime-'));const store=createEventStore({stateDir:dir}),state=createHostState(store),now=()=>Date.parse('2026-11-05T15:30:00Z'),diary=createDiary({store,now});const binding={sessionId:'s',platform:channel.startsWith('bili')?'bili':'qq',channel,scope:channel.startsWith('p:')?'private:qq':'public',eventId:'source',requestId:'r',targetId:channel.startsWith('p:')?'42':'BV1234567890',sourceTargetId:channel.startsWith('p:')?'42':'BV1234567890',consumed:true};let request, sent;const life=createLifeRuntime({config:{stateDir:dir,qq:{enabled:true}},state,store,diary,replyTickets:{authorize:(ticket?: any,r?: any)=>{request=r;return binding;}},caller:()=>binding,send:async(s?: any,a?: any)=>{sent={s,a};return store.append({id:'sent',kind:'message.sent',channel,actorId:'fish',text:a.text,meta:{messageId:'99'}});},now});t.after(async()=>{await life.close();store.close();fs.rmSync(dir,{recursive:true,force:true});});return {life,store,state,binding,get request(){return request},get sent(){return sent}};}
test('QQ uses bound recipient and canonical receipt without changing body',async (t?: any) =>{const f=fixture(t);const r: any=await f.life.owner.handle({platform:'qq',operation:'write',args:{ticket:'t',action:'dm',targetId:'42',intentId:'i',text:'hello',parentId:'source',context:{channel:'p:99'}}});assert.equal(r.journaledEventId,'sent');assert.deepEqual(f.sent,{s:'s',a:{text:'hello',replyTo:'source'}});await assert.rejects(f.life.owner.handle({platform:'qq',operation:'write',args:{ticket:'t',action:'dm',targetId:'99',intentId:'j',text:'bad'}}));});
test('diary scope is derived from consumed binding and sources cannot cross scopes',(t)=>{const f=fixture(t);f.store.append({id:'private',kind:'message.received',channel:'p:42',actorId:'42',text:'hello'});f.store.append({id:'public',kind:'message.received',channel:'g:1',actorId:'1',text:'hi'});const entry={scope:'private:qq',date:'2026-11-05',sourceEventIds:['private'],text:'hello'};assert.throws(()=>f.life.writeDiary('s',{...entry,scope:'public'}));assert.throws(()=>f.life.writeDiary('s',{...entry,sourceEventIds:['public']}));assert.equal(f.life.writeDiary('s',entry).scope,'private:qq');f.binding.consumed=false;assert.throws(()=>f.life.readDiary('s',{scope:'private:qq',date:entry.date}));});
test('diary opportunity selects only today occurred sources and claims once',async (t?: any) =>{const f=fixture(t);for(const [id,kind,at,meta] of [['today','message.received','2026-11-05T10:00:00Z',{}],['old','message.received','2026-11-04T10:00:00Z',{}],['plan','timer','2026-11-05T10:00:00Z',{}]])f.store.append({id,kind,at,channel:'p:42',actorId:'42',text:id,meta});await f.life.pollDiary();await f.life.pollDiary();const e=f.store.get('diary-opportunity:private:qq:2026-11-05');assert.deepEqual(e.meta.sourceEventIds,['today']);assert.equal(f.store.recent({channel:'diary:private:qq',groups:false}).length,1);});
test('bilibili ticket platform is normalized for the owner',async (t?: any) =>{const f=fixture(t,'bili:public');await f.life.owner.handle({platform:'bilibili',operation:'read',args:{ticket:'t',action:'feed'}}).catch(()=>{});assert.equal(f.request.platform,'bili');});
test('bilibili search returns real video identifiers from service output',async (t?: any) =>{const dir=fs.mkdtempSync(path.join(os.tmpdir(),'life-bili-')),store=createEventStore({stateDir:dir}),state=createHostState(store);const binding={sessionId:'s',platform:'bili',channel:'bili:public',scope:'public',eventId:'source',targetId:'BV1xx411c7mD',consumed:true};const life=createLifeRuntime({config:{stateDir:dir,bili:{enabled:true}},state,store,diary:createDiary({store}),replyTickets:{authorize:()=>binding},caller:()=>binding,biliService:{call:async()=>({content:[{type:'text',text:'Source: search\n[1] My video\n    BV=BV1xx411c7mD  UP=Person'}]})}});t.after(async()=>{await life.close();store.close();fs.rmSync(dir,{recursive:true,force:true});});const r: any=await life.owner.handle({platform:'bilibili',operation:'read',args:{ticket:'t',action:'search',query:'fish'}});assert.equal(r.items[0].id,'BV1xx411c7mD');});
test('diary defaults scope from trusted binding for write read and search',(t)=>{const f=fixture(t);f.store.append({id:'source-private',kind:'message.received',channel:'p:42',actorId:'42',text:'hello'});const entry=f.life.writeDiary('s',{date:'2026-11-05',sourceEventIds:['source-private'],text:'daily memory'});assert.equal(entry.scope,'private:qq');assert.throws(()=>f.life.readDiary('s',{date:'2026-11-05'}));assert.throws(()=>f.life.searchDiary('s',{query:'daily'}));Object.assign(f.binding,{role:'diary',channel:'diary:private:qq'});f.state.put('platform-session','internal-diary',{key:'evolution.diary',sessionId:'s',workspace:'evolution'});assert.equal(f.life.readDiary('s',{date:'2026-11-05'}).id,entry.id);assert.equal(f.life.searchDiary('s',{query:'daily'}).length,1);assert.throws(()=>f.life.readDiary('s',{scope:'private:bili',date:'2026-11-05'}));assert.throws(()=>f.life.searchDiary('s',{scope:'public',query:'daily'}));});
test('internal diary writes require the current opportunity and reject cancelled calls',(t)=>{const f=fixture(t,'diary:private:qq');Object.assign(f.binding,{role:'diary',scope:'private:qq'});f.store.append({id:'actual',kind:'message.received',channel:'p:42',actorId:'42',text:'hello'});f.store.append({id:'other',kind:'message.received',channel:'p:42',actorId:'42',text:'other'});f.store.append({id:'source',kind:'timer',channel:'diary:private:qq',actorId:'fish',text:'opportunity',meta:{date:'2026-11-05',sourceEventIds:['actual']}});const input={date:'2026-11-05',sourceEventIds:['actual'],text:'daily'};assert.throws(()=>f.life.writeDiary('s',{...input,sourceEventIds:['other']}));const ac=new AbortController();ac.abort();assert.throws(()=>f.life.writeDiary('s',input,ac.signal));assert.equal(f.life.writeDiary('s',input).sourceEventIds[0],'actual');});

test('mixed internal journal content cannot be read or searched by any external scope',(t)=>{const f=fixture(t,'diary:public');Object.assign(f.binding,{role:'diary',scope:'public'});f.state.put('platform-session','internal-diary',{key:'evolution.diary',sessionId:'s',workspace:'evolution'});f.store.append({id:'pub',kind:'message.received',channel:'g:1',actorId:'1',text:'public source'});f.store.append({id:'source',kind:'timer',channel:'diary:public',actorId:'fish',text:'opportunity',meta:{date:'2026-11-05',sourceEventIds:['pub']}});const entry=f.life.writeDiary('s',{date:'2026-11-05',sourceEventIds:['pub'],text:'PRIVATE_MARKER remembered from prior private turn'});assert.equal(f.life.readDiary('s',{id:entry.id}).id,entry.id);for(const [role,channel,scope] of [['qq','g:1','public'],['qq','p:42','private:qq'],['bili','bili:public','public'],['qzone','qzone:friends','qzone:friends']]){Object.assign(f.binding,{role,channel,scope});assert.throws(()=>f.life.readDiary('s',{id:entry.id}));assert.throws(()=>f.life.searchDiary('s',{query:'PRIVATE_MARKER'}));}});
