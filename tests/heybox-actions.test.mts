import test from 'node:test';
import assert from 'node:assert/strict';
import {mkdtemp,writeFile} from 'node:fs/promises';
import {tmpdir} from 'node:os';
import {join} from 'node:path';
import {createHeyboxPlatform} from '../src/adapters/heybox.mjs';

const ok=(result)=>({payload:{status:'ok',result},cookies:{}});
async function fixture({token=true,mutate,transport}: { token?: boolean; mutate?: any; transport?: any; [key: string]: any }={}) {
 const stateDir=await mkdtemp(join(tmpdir(),'heybox-actions-'));await writeFile(join(stateDir,'auth.json'),JSON.stringify({cookies:{heybox_id:'42',pkey:'secret',...(token?{x_xhh_tokenid:'official-browser-token'}:{})}}));
 const calls=[];let wrote=false;const run=async (r?: any) =>{calls.push(r);if(transport)return transport(r);if(r.path==='/account/restore_login')return ok({profile:{heybox_id:'42'}});
  if(r.method==='POST'){wrote=true;return {payload:{status:'ok',commentid:'90',result:{link_id:'80'}},cookies:{}};}
  let v=ok({link:{linkid:r.params.link_id,userid:r.params.link_id==='80'?'42':'8',text:'hello',is_award_link:wrote?1:0},comments:[{comment:[{commentid:'10',userid:'8',text:'root'},{commentid:'11',userid:'9',text:'nested'},...(wrote?[{commentid:'90',userid:'42',text:'hello',reply_id:'11'}]:[])]}]});return mutate?mutate(v,r,wrote):v;
 };const p=createHeyboxPlatform({stateDir,transport:run});return {p,calls};
}
test('like confirms only verified identity, target and liked state after a single form POST',async()=>{const {p,calls}=await fixture();const r: any=await p.write({action:'like',targetId:'7',intentId:'i'});assert.equal(r.confirmed,true);assert.equal(r.platformId,'7');assert.equal(r.accountId,'42');assert.equal(r.targetId,'7');const writes=calls.filter((x)=>x.method==='POST');assert.equal(writes.length,1);assert.equal(writes[0].path,'/bbs/app/profile/award/link');assert.deepEqual(writes[0].body,{link_id:'7',award_type:'1'});await p.close();});
test('nested reply resolves actual root and verifies created comment identity',async()=>{const {p,calls}=await fixture();const r: any=await p.write({action:'reply',targetId:'7',parentId:'11',text:'hello',intentId:'i'});assert.equal(r.confirmed,true);assert.equal(r.platformId,'90');const req=calls.find((x)=>x.method==='POST');assert.equal(req.body.root_id,'10');assert.equal(req.body.reply_id,'11');await p.close();});
test('comment uses top-level IDs and accepts only a matching created comment',async()=>{const {p,calls}=await fixture({mutate:(v?: any,r?: any,wrote?: any)=>{if(wrote)v.payload.result.comments=[{comment:[{commentid:'90',userid:'42',text:'hello'}]}];return v;}});assert.equal((await p.write({action:'comment',targetId:'7',text:'hello',intentId:'i'})).confirmed,true);assert.equal(calls.find((x)=>x.method==='POST').body.root_id,'-1');await p.close();});
test('publish takes context.title and confirms real link through own author readback',async()=>{const {p,calls}=await fixture();const r: any=await p.write({action:'publish',targetId:'own-public',text:'hello',intentId:'i',context:{title:'A title'}});assert.equal(r.confirmed,true);assert.equal(r.platformId,'80');assert.equal(r.targetId,'own-public');const req=calls.find((x)=>x.method==='POST');assert.equal(req.body.title,'A title');assert.deepEqual(JSON.parse(req.body.text),[{type:'text',text:'hello'}]);await p.close();});
test('missing browser session refuses before a write without fabricating a token',async()=>{const {p,calls}=await fixture({token:false});const r: any=await p.write({action:'comment',targetId:'7',text:'hello',intentId:'i'});assert.equal(r.code,'web_session_required');assert.equal(calls.filter((x)=>x.method==='POST').length,0);await p.close();});

test('authenticated status retains observed detail verification failure and untested write health',async()=>{
 let blocked=true;const {p}=await fixture({transport:async (r?: any) =>r.path.includes('restore_login')?ok({profile:{heybox_id:'42'}}):blocked?{payload:{status:'show_captcha',result:{},msg:''}}:ok({link:{linkid:'7',text:'body'}})});
 assert.deepEqual((await p.read({action:'detail',id:'7'})).warnings,['verification_required']);
 const health=await p.status();assert.equal(health.state,'ready');assert.deepEqual(health.authentication,{state:'ready'});assert.equal(health.operations.detail.state,'verification_required');assert.equal(health.operations.publish.state,'unknown');assert.equal(typeof health.operations.detail.checkedAt,'number');
 blocked=false;await p.read({action:'detail',id:'7'});assert.equal((await p.status()).operations.detail.state,'ready');await p.close();
});
test('a failed target preflight is recorded without sending a comment',async()=>{
 const {p,calls}=await fixture({transport:async (r?: any) =>r.path.includes('restore_login')?ok({profile:{heybox_id:'42'}}):{payload:{status:'show_captcha',result:{}}}});
 const r: any=await p.write({action:'comment',targetId:'7',text:'hello',intentId:'i'});assert.equal(r.state,'verification_required');assert.equal(calls.filter((x)=>x.method==='POST').length,0);assert.equal((await p.status()).operations.comment.state,'verification_required');await p.close();
});
test('explicit CAPTCHA rejection of publish is reported without an ambiguous send or retry',async()=>{
 const {p,calls}=await fixture({transport:async (r?: any) =>r.path.includes('restore_login')?ok({profile:{heybox_id:'42'}}):{payload:{status:'show_captcha',result:{}}}});
 const r: any=await p.write({action:'publish',targetId:'own-public',text:'hello',intentId:'i'});assert.equal(r.state,'verification_required');assert.equal(r.confirmed,false);assert.equal(calls.filter((x)=>x.method==='POST').length,1);await p.close();
});
test('accepted publish followed by CAPTCHA retains receipt as unknown and never retries',async()=>{
 const {p,calls}=await fixture({transport:async (r?: any) =>r.path.includes('restore_login')?ok({profile:{heybox_id:'42'}}):r.method==='POST'?ok({link_id:'80'}):{payload:{status:'show_captcha',result:{}}}});
 const r: any=await p.write({action:'publish',targetId:'own-public',text:'hello',intentId:'i'});assert.equal(r.state,'unknown');assert.equal(r.confirmed,false);assert.equal(r.receiptId,'80');assert.equal(r.code,'readback_verification_required');assert.equal(calls.filter((x)=>x.method==='POST').length,1);await p.close();
});
test('unknown parent refuses before submission',async()=>{const {p,calls}=await fixture();assert.equal((await p.write({action:'reply',targetId:'7',parentId:'999',text:'hello',intentId:'i'})).state,'refused');assert.equal(calls.filter((x)=>x.method==='POST').length,0);await p.close();});
for(const mismatch of ['actor','target','text'])test(`write remains unknown for ${mismatch} readback mismatch`,async()=>{const {p}=await fixture({mutate:(v?: any,r?: any,wrote?: any)=>{if(wrote){if(mismatch==='actor')v.payload.result.comments[0].comment[2].userid='999';if(mismatch==='target')v.payload.result.link.linkid='999';if(mismatch==='text')v.payload.result.comments[0].comment[2].text='other';}return v;}});assert.equal((await p.write({action:'reply',targetId:'7',parentId:'11',text:'hello',intentId:'i'})).state,'unknown');await p.close();});
test('POST timeout stays unknown and is never retried',async()=>{let writes=0;const {p}=await fixture({transport:async (r?: any) =>{if(r.method==='POST'){writes++;throw new Error('timeout');}return r.path.includes('restore_login')?ok({profile:{heybox_id:'42'}}):ok({link:{linkid:'7',userid:'8',is_award_link:0}});}});assert.equal((await p.write({action:'like',targetId:'7',intentId:'i'})).state,'unknown');assert.equal(writes,1);await p.close();});
test('cancelled POST passes AbortSignal and ignores a late successful receipt',async()=>{const c=new AbortController();let signal;const {p}=await fixture({transport:async (r?: any) =>{if(r.method==='POST'){signal=r.signal;c.abort();return ok({});}return r.path.includes('restore_login')?ok({profile:{heybox_id:'42'}}):ok({link:{linkid:'7',is_award_link:0}});}});assert.equal((await p.write({action:'like',targetId:'7',intentId:'i',signal:c.signal})).state,'unknown');assert.equal(signal.aborted,true);await p.close();});
test('notifications remain public and distinct from private inbox',async()=>{const {p,calls}=await fixture({transport:async()=>ok({messages:[{message_id:'200',comment_a_id:'31',comment_a_text:'hello',root_comment_id:'30',linkid:'7',userid_a:'9',message_type:17}]})});const r=await p.read({action:'notifications'});assert.equal(r.items[0].id,'200');assert.equal(r.items[0].visibility,'public');assert.equal(r.items[0].targetId,'7');assert.equal(r.items[0].parentId,'31');assert.equal(calls[0].params.list_type,'0');assert.equal(p.capabilities.dm,true);await p.close();});
test('website notification endpoint accepts observed empty entries array',async()=>{const {p}=await fixture({transport:async()=>ok({message_unread_num:0,entries:[]})});const r=await p.read({action:'notifications'});assert.deepEqual(r,{items:[],truncated:false,warnings:[]});await p.close();});
test('notifications preserve platform event time and never synthesize a current timestamp',async()=>{const {p}=await fixture({transport:async()=>ok({messages:[{message_id:'200',comment_a_id:'31',comment_a_text:'hello',linkid:'7',userid_a:'9',timestamp:'1793836800'},{message_id:'201',comment_a_id:'32',linkid:'7',userid_a:'9'}]})});const r=await p.read({action:'notifications'});assert.equal(r.items[0].at,1793836800000);assert.equal(r.items[1].at,undefined);await p.close();});
test('unsafe numeric IDs are rejected instead of rounding into false platform identity',async()=>{const {p}=await fixture({transport:async()=>ok({messages:[{message_id:Number.MAX_SAFE_INTEGER+2,comment_a_id:'31',linkid:'7',userid_a:'9'}]})});const r=await p.read({action:'notifications'});assert.deepEqual(r.items,[]);assert.deepEqual(r.warnings,['notification_missing_route']);await p.close();});
test('real HTTP transport encodes one authenticated form POST and normal website signatures',async()=>{
 const stateDir=await mkdtemp(join(tmpdir(),'heybox-http-'));await writeFile(join(stateDir,'auth.json'),JSON.stringify({cookies:{heybox_id:'42',pkey:'secret',x_xhh_tokenid:'website'}}));
 const original=globalThis.fetch;let posts=0;
 globalThis.fetch=async(url?: any,options?: any)=>{let result;if(url.pathname.includes('restore_login'))result={profile:{heybox_id:'42'}};else if(options.method==='POST'){posts++;assert.equal(url.pathname,'/bbs/app/profile/award/link');assert.equal(url.searchParams.has('heybox_id'),false);assert.match(url.searchParams.get('_rnd'),/^15:[a-f0-9]{64}$/);assert.equal(url.searchParams.get('web_version'),'3.0');assert.match(options.headers['Content-Type'],/x-www-form-urlencoded/);assert.equal(new URLSearchParams(options.body).get('link_id'),'7');result={};}else result={link:{linkid:'7',is_award_link:posts?1:0}};return new Response(JSON.stringify({status:'ok',result}),{headers:{'Content-Type':'application/json'}});};
 const p=createHeyboxPlatform({stateDir});try {assert.equal((await p.write({action:'like',targetId:'7',intentId:'i'})).confirmed,true);assert.equal(posts,1);}finally{globalThis.fetch=original;await p.close();}
});
