import test from 'node:test';
import assert from 'node:assert/strict';
import { mkdtempSync, rmSync } from 'node:fs';
import { tmpdir } from 'node:os';
import { join } from 'node:path';
import { setTimeout as delay } from 'node:timers/promises';
import { createEventStore } from '../src/core/events.mjs';
import { createRouter } from '../src/core/router.mjs';
const event=(id?: any,channel: string='g:1',extra: Record<string, any>={})=>({id,channel,kind:'message.received',actorId:id,text:id,...extra});
function fixture(t?: any){const stateDir=mkdtempSync(join(tmpdir(),'batch-'));const store=createEventStore({stateDir});const routers=[];t.after(async()=>{for(const r of routers)await r.close();store.close();rmSync(stateDir,{recursive:true,force:true});});return {store,router(options?: any){const r=createRouter({store,...options});routers.push(r);return r;}};}
async function until(fn?: any){for(let n=0;n<150;n++){if(fn())return;await delay(5);}assert.fail('timed out');}
test('fixed channel window performs one assessment and one source-bound dispatch',async (t?: any) =>{const f=fixture(t),calls=[],sent=[],batches=[];const r=f.router({batchWindowMs:400,onBatch:(b)=>batches.push(b),assess:async (p?: any) =>{calls.push(p);return {actions:p.events.map((e)=>({eventId:e.id,kind:'respond'}))};},dispatch:async(a?: any,e?: any,c?: any)=>sent.push({a,e,c})});await r.ingest(event('a'));await delay(20);await r.ingest(event('b','g:1',{meta:{quotedId:'a'}}));await r.ingest(event('b'));await delay(20);assert.equal(calls.length,0);await until(()=>sent.length);assert.equal(calls.length,1);assert.equal(sent.length,1);assert.deepEqual(calls[0].events.map((e)=>e.id),['a','b']);assert.deepEqual(sent[0].c.batch.sourceEventIds,['a','b']);assert.equal(sent[0].e.text,sent[0].e.id);assert.equal(batches.length,1);assert.equal(batches[0].originals[1].meta.quotedId,'a');});
test('pending deadline survives restart and other channels stay separate',async (t?: any) =>{const f=fixture(t),calls=[];const options={batchWindowMs:400,assess:async (p?: any) =>{calls.push(p);return {actions:[]};},dispatch:async()=>{}};let r=f.router(options);await r.ingest(event('a'));await delay(25);const deadline=f.store.db.prepare('SELECT next_at FROM core_router WHERE event_id=?').get('a').next_at;await r.close();r=f.router(options);await r.ingest(event('b'));await r.ingest(event('c','g:2'));assert.equal(f.store.db.prepare('SELECT next_at FROM core_router WHERE event_id=?').get('b').next_at,deadline);await until(()=>calls.length===2);assert.deepEqual(calls.map((p)=>p.events.map((e)=>e.id)),[['a','b'],['c']]);});
test('new arrival during processing enters next batch; urgent bypasses wait',async (t?: any) =>{const f=fixture(t),calls=[];let release;const held=new Promise<any | void>((r)=>release=r);const r=f.router({batchWindowMs:70,urgent:(e)=>e.id==='stop',assess:async (p?: any) =>{calls.push(p);if(calls.length===1)await held;return {actions:[]};},dispatch:async()=>{}});await r.ingest(event('a'));await until(()=>calls.length===1);await r.ingest(event('b'));release();await until(()=>calls.length===2);assert.deepEqual(calls.map((p)=>p.events.map((e)=>e.id)),[['a'],['b']]);await r.ingest(event('wait'));await r.ingest(event('stop'));await until(()=>calls.some((p)=>p.events.some((e)=>e.id==='stop')));const stopped=calls.find((p)=>p.events.some((e)=>e.id==='stop'));assert.equal(stopped.events.length,1);});
test('bounded projection marks omissions and retains authoritative originals',async (t?: any) =>{const f=fixture(t),calls=[],batches=[];const r=f.router({batchWindowMs:200,policy:{batchMaxEvents:2,batchMaxChars:5},onBatch:(b)=>batches.push(b),assess:async (p?: any) =>{calls.push(p);return {actions:[]};},dispatch:async()=>{}});for(const id of ['a','b','c'])await r.ingest(event(id,'g:1',{text:'long original text'}));await until(()=>calls.length);assert.ok(calls[0].events.length<=2);assert.ok(calls[0].events.reduce((n?: any,e?: any)=>n+e.text.length,0)<=5);assert.equal(calls[0].batch.truncated,true);assert.deepEqual(batches[0].sourceEventIds,['a','b','c']);assert.equal(batches[0].originals[0].text,'long original text');assert.equal(f.store.get('a').text,'long original text');});

test('observe decisions do not swallow the one actionable choice, with original authority',async (t?: any) =>{const f=fixture(t),sent=[];const r=f.router({batchWindowMs:200,assess:async ({events}: { events?: any; [key: string]: any })=>({actions:[{eventId:events[0].id,kind:'observe'},{eventId:events[1].id,kind:'task'},{eventId:events[2].id,kind:'respond'}]}),dispatch:async(a?: any,e?: any)=>sent.push({a,e})});await r.ingest(event('admin','g:1',{text:'admin context'}));await r.ingest(event('user','g:1',{text:'user request'}));await r.ingest(event('another'));await until(()=>sent.length);assert.equal(sent.length,1);assert.equal(sent[0].e.actorId,'user');assert.equal(sent[0].e.text,'user request');});
test('batch audit observes every unchosen source and ambiguous dispatch never replays',async (t?: any) =>{const f=fixture(t),sent=[];const options={batchWindowMs:150,assess:async ({events}: { events?: any; [key: string]: any })=>({actions:events.map((e)=>({eventId:e.id,kind:'respond'}))}),dispatch:async(a?: any,e?: any)=>{sent.push(e.id);throw new Error('ambiguous');}};let r=f.router(options);await r.ingest(event('a'));await r.ingest(event('b'));await until(()=>r.status().counts.uncertain===1);assert.equal(r.status().counts.observed,1);await r.close();r=f.router(options);await r.ingest(event('b'));await delay(180);assert.equal(sent.length,1);assert.equal(r.status().counts.uncertain,1);});
test('passive and policy blocked messages never enter a semantic batch',async (t?: any) =>{const f=fixture(t),calls=[],batches=[];const r=f.router({batchWindowMs:150,policy:(e)=>e.actorId!=='blocked',onBatch:(b)=>batches.push(b),assess:async (p?: any) =>{calls.push(p);return {actions:[]};},dispatch:async()=>{}});await r.ingest(event('blocked'));await r.ingest(event('self','g:1',{kind:'message.sent',meta:{messageId:'receipt'}}));await r.ingest(event('ok'));await until(()=>calls.length);assert.deepEqual(batches[0].sourceEventIds,['ok']);assert.equal(r.status().counts.observed,3);});
