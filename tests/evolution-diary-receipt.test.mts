import test from 'node:test';import assert from 'node:assert/strict';import fs from 'node:fs';import os from 'node:os';import path from 'node:path';
import {createEventStore} from '../src/core/events.mjs';import {createHostState} from '../src/host/state.mjs';import {createDiary} from '../src/host/diary.mjs';import {createLifeRuntime} from '../src/host/life-runtime.mjs';import {createPlatformSessions} from '../src/host/platform-sessions.mjs';import {createEvolution} from '../src/host/evolution.mjs';
const flush=()=>new Promise<any | void>((r)=>setImmediate(r));
function setup(t?: any){const dir=fs.mkdtempSync(path.join(os.tmpdir(),'diary-receipt-')),store=createEventStore({stateDir:dir}),state=createHostState(store);let time=Date.parse('2026-11-05T15:30:00Z'),evo;const now=()=>time,diary=createDiary({store,now}),calls=[];const caller=(id)=>{const c=state.binding(id),job=state.get('platform-job',c?.requestId);if(job?.status!=='starting')throw Error('inactive');return {...c,sessionId:id};};const sessions=createPlatformSessions({state,characterId:'fish',now,ensure:async()=>{},onFinished:(job)=>evo?.finish(job),execute:async (x?: any) =>{state.bind(x.sessionId,{...x.binding,requestId:x.action.dispatchId,role:x.event.channel.startsWith('diary:')?'diary':'evolution'});calls.push(x);}});const opts={state,store,diary,sessions,caller,now,config:{reviewIntervalMs:60000}};evo=createEvolution(opts);const makeLife=()=>createLifeRuntime({config:{stateDir:dir,qq:{enabled:false}},state,store,diary,caller,replyTickets:{},now,onDiary:(event)=>evo.enqueueDiary(event)});let life=makeLife();t.after(async()=>{await life.close();await evo.close();await sessions.close();store.close();fs.rmSync(dir,{recursive:true,force:true});});store.append({id:'real',kind:'message.received',channel:'g:1',actorId:'42',text:'tea',at:new Date(time).toISOString()});return {store,state,diary,sessions,calls,get evo(){return evo},get life(){return life},set time(v: any){time=v},get time(){return time},async restart(){await life.close();await evo.close();evo=createEvolution(opts);life=makeLife();await evo.start();}};}
const consume=(f?: any,c?: any)=>f.sessions.event(c.sessionId,{type:'user/message',data:{source:{rpcId:c.action.dispatchId}}});
const end=(f?: any,c?: any)=>f.sessions.event(c.sessionId,{type:'turn/end'});
const diaryCalls=(f)=>f.calls.filter((c)=>c.event.channel.startsWith('diary:'));
async function begin(f?: any){await f.sessions.start();await f.evo.start();await f.life.pollDiary({initial:true});await flush();return diaryCalls(f)[0];}
test('reportless diary remains incomplete after restart, retries once, then requires attention',async (t?: any) =>{const f=setup(t),c=await begin(f);consume(f,c);end(f,c);assert.equal(f.state.get('evolution-turn',c.action.dispatchId)?.status,'incomplete');assert.equal(f.diary.read({scope:'public',date:'2026-11-05'},{scopes:['public']}),undefined);await f.restart();await f.life.pollDiary({initial:true});assert.equal(diaryCalls(f).length,1);f.time+=60001;await f.evo.poll();await flush();const retry=diaryCalls(f)[1];assert.ok(retry);assert.deepEqual(retry.event.meta.sourceEventIds,['real']);consume(f,retry);end(f,retry);f.time+=60001;await f.evo.poll();await f.life.pollDiary();assert.equal(diaryCalls(f).length,2);assert.equal(f.state.get('evolution-turn',retry.action.dispatchId).status,'attention_required');});
test('saved diary receipt survives restart and repeated call without duplicate versions',async (t?: any) =>{const f=setup(t),c=await begin(f);consume(f,c);const args={date:'2026-11-05',sourceEventIds:['real'],text:'今天聊茶'};assert.throws(()=>f.life.writeDiary(c.sessionId,{...args,date:'2026-11-04'}));const entry=f.life.writeDiary(c.sessionId,args);assert.equal(f.life.writeDiary(c.sessionId,args).id,entry.id);end(f,c);assert.equal(f.state.get('evolution-turn',c.action.dispatchId).status,'completed');await f.restart();f.time+=120001;await f.evo.poll();await f.life.pollDiary();assert.equal(diaryCalls(f).length,1);assert.equal(f.store.db.prepare('SELECT COUNT(*) AS n FROM life_diary').get().n,1);});
test('explicit internal diary decline completes only the bound scope/date without creating entry',async (t?: any) =>{const f=setup(t),c=await begin(f);assert.throws(()=>f.life.skipDiary(c.sessionId,{reason:'没想写的'}));consume(f,c);const ac=new AbortController();ac.abort();assert.throws(()=>f.life.skipDiary(c.sessionId,{reason:'没想写的'},ac.signal));assert.equal(f.life.skipDiary(c.sessionId,{reason:'今天没有想写的内容'}).status,'declined');assert.throws(()=>f.life.writeDiary(c.sessionId,{date:'2026-11-05',sourceEventIds:['real'],text:'late conflicting write'}));end(f,c);await f.restart();f.time+=120001;await f.evo.poll();await f.life.pollDiary();assert.equal(diaryCalls(f).length,1);assert.equal(f.store.db.prepare('SELECT COUNT(*) AS n FROM life_diary').get().n,0);assert.equal(f.state.get('evolution-turn',c.action.dispatchId).status,'completed');});
test('same-date private receipt cannot complete the reportless public diary opportunity',async (t?: any) =>{const f=setup(t);f.store.append({id:'private-real',kind:'message.received',channel:'p:42',actorId:'42',text:'private tea',at:new Date(f.time).toISOString()});const pub=await begin(f);assert.equal(pub.event.channel,'diary:public');consume(f,pub);end(f,pub);await flush();const priv=diaryCalls(f).find((c)=>c.event.channel==='diary:private:qq');assert.ok(priv);consume(f,priv);f.life.writeDiary(priv.sessionId,{date:'2026-11-05',sourceEventIds:['private-real'],text:'private diary'});end(f,priv);assert.equal(f.state.get('evolution-turn',pub.action.dispatchId).status,'incomplete');assert.equal(f.state.get('evolution-turn',priv.action.dispatchId).status,'completed');f.time+=60001;await f.evo.poll();await flush();assert.equal(diaryCalls(f).filter((c)=>c.event.channel==='diary:public').length,2);assert.equal(diaryCalls(f).filter((c)=>c.event.channel==='diary:private:qq').length,1);});
test('saved diary entry recovers a missing receipt before scheduling another version',async (t?: any) =>{const f=setup(t),c=await begin(f);consume(f,c);const entry=f.diary.write({scope:'public',date:'2026-11-05',sourceEventIds:['real'],text:'saved just before crash'},{scopes:['public']});assert.equal(f.state.get('diary-receipt',c.action.dispatchId),undefined);end(f,c);assert.equal(f.state.get('diary-receipt',c.action.dispatchId).entryId,entry.id);await f.restart();f.time+=120001;await f.evo.poll();assert.equal(diaryCalls(f).length,1);assert.equal(f.store.db.prepare('SELECT COUNT(*) AS n FROM life_diary').get().n,1);});
