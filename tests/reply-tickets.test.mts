import {test} from 'node:test';
import assert from 'node:assert/strict';
import {createReplyTickets} from '../src/host/reply-tickets.mjs';
const memory=()=>{const m=new Map();return {get:(k?: any,id?: any)=>m.get(k+':'+id),put:(k?: any,id?: any,v?: any)=>m.set(k+':'+id,structuredClone(v)),list:(k)=>[...m].filter(([x])=>x.startsWith(k+':')).map(([x,v])=>({id:x.slice(k.length+1),...v}))}};
test('a private message source ID cannot shadow the canonical recipient in owner authorization',()=>{
 const state=memory(),tickets=createReplyTickets({state});state.put('binding','s',{requestId:'r',consumed:true,channel:'bili:dm:42',eventId:'message-999',actorId:'42'});
 const ticket=tickets.issue({sessionId:'s',requestId:'r',platform:'bili',audience:'dm',scope:'private:bili',channel:'bili:dm:42',eventId:'message-999',actorId:'42',sourceTargetId:'message-999'});
 const binding=tickets.authorize(ticket,{platform:'bili',operation:'write',targetId:'42'});assert.equal(binding.targetId,'42');assert.equal(binding.sourceTargetId,'42');
});
test('ticket binds consumed request and exact DM target and expires',()=>{let time=10;const state=memory(),tickets=createReplyTickets({state,now:()=>time,ttlMs:20});state.put('binding','s',{requestId:'r',consumed:true,channel:'p:12',eventId:'e',actorId:'12'});const t=tickets.issue({sessionId:'s',requestId:'r',platform:'qq',audience:'dm',scope:'private:qq',channel:'p:12',eventId:'e',actorId:'12'});assert.equal(tickets.authorize(t,{platform:'qq',operation:'dm',targetId:'12'}).eventId,'e');assert.throws(()=>tickets.authorize(t,{platform:'qq',operation:'dm',targetId:'13'}));assert.throws(()=>tickets.authorize(t,{platform:'bili',operation:'dm',targetId:'12'}));state.put('binding','s',{requestId:'new',consumed:true});assert.throws(()=>tickets.authorize(t,{platform:'qq',operation:'dm',targetId:'12'}));state.put('binding','s',{requestId:'r',consumed:false,channel:'p:12',eventId:'e',actorId:'12'});assert.throws(()=>tickets.authorize(t,{platform:'qq',operation:'dm',targetId:'12'}));state.put('binding','s',{requestId:'r',consumed:true,channel:'p:12',eventId:'e',actorId:'12'});time=30;assert.throws(()=>tickets.authorize(t,{platform:'qq',operation:'dm',targetId:'12'}));});
test('revocation blocks request tickets and public writes use source item',()=>{const state=memory(),t=createReplyTickets({state,now:()=>1});state.put('binding','s',{requestId:'r',consumed:true,channel:'bili:public',eventId:'item'});const id=t.issue({sessionId:'s',requestId:'r',platform:'bili',audience:'public',channel:'bili:public',eventId:'item'});assert.throws(()=>t.authorize(id,{platform:'bili',operation:'comment',targetId:'other'}));assert.equal(t.authorize(id,{platform:'bili',operation:'comment',targetId:'item'}).targetId,'item');t.revokeForRequest('r');assert.throws(()=>t.authorize(id,{platform:'bili',operation:'comment',targetId:'item'}));});

test('public source target uses the host-provided platform item while DM ignores overrides',()=>{const state=memory(),t=createReplyTickets({state,now:()=>1});state.put('binding','surf',{requestId:'surf-r',consumed:true,channel:'bili:public',eventId:'host-event',actorId:'author'});const surf=t.issue({sessionId:'surf',requestId:'surf-r',platform:'bili',audience:'public',channel:'bili:public',eventId:'host-event',actorId:'author',sourceTargetId:'platform-item'});assert.equal(t.authorize(surf,{platform:'bili',operation:'comment',targetId:'platform-item'}).sourceTargetId,'platform-item');assert.throws(()=>t.authorize(surf,{platform:'bili',operation:'comment',targetId:'another-item'}));state.put('binding','dm',{requestId:'dm-r',consumed:true,channel:'p:12',eventId:'e',actorId:'12'});const dm=t.issue({sessionId:'dm',requestId:'dm-r',platform:'qq',audience:'dm',channel:'p:12',eventId:'e',actorId:'12',sourceTargetId:'13'});assert.throws(()=>t.authorize(dm,{platform:'qq',operation:'dm',targetId:'13'}));assert.equal(t.authorize(dm,{platform:'qq',operation:'dm',targetId:'12'}).targetId,'12');});
test('host may grant only scope-appropriate own publication targets',()=>{const state=memory(),t=createReplyTickets({state,now:()=>1});const make=(sessionId?: any,requestId?: any,platform?: any,audience?: any,scope?: any,channel?: any,allowedOwnTarget?: any)=>{state.put('binding',sessionId,{requestId,consumed:true,channel,eventId:'source',actorId:'author'});return t.issue({sessionId,requestId,platform,audience,scope,channel,eventId:'source',actorId:'author',sourceTargetId:'item',allowedOwnTarget});};const pub=make('s','r','bili','public','public','bili:public','own-public');assert.equal(t.authorize(pub,{platform:'bili',operation:'publish',targetId:'own-public'}).allowedOwnTarget,'own-public');assert.equal(t.authorize(pub,{platform:'bili',operation:'comment',targetId:'item'}).targetId,'item');assert.throws(()=>t.authorize(pub,{platform:'bili',operation:'publish',targetId:'other'}));const friends=make('f','fr','qzone','friends','qzone:friends','qzone:friends','own-friends');assert.equal(t.authorize(friends,{platform:'qzone',operation:'publish',targetId:'own-friends'}).allowedOwnTarget,'own-friends');assert.throws(()=>make('x','x','bili','public','public','bili:public','own-friends'));assert.throws(()=>make('x','x','qzone','friends','qzone:friends','qzone:friends','own-public'));assert.throws(()=>make('x','x','qq','dm','private:qq','p:12','own-public'));assert.throws(()=>make('x','x','bili','public','public','bili:public','arbitrary'));});
test('DM delivery target comes from the channel even when a worker produced the source',()=>{const state=memory(),t=createReplyTickets({state,now:()=>1});state.put('binding','s',{requestId:'r',consumed:true,channel:'p:123',eventId:'task-result',actorId:'fish-worker'});const ticket=t.issue({sessionId:'s',requestId:'r',platform:'qq',audience:'dm',scope:'private:qq',channel:'p:123',eventId:'task-result',actorId:'fish-worker',sourceTargetId:'999'});assert.equal(t.authorize(ticket,{platform:'qq',operation:'dm',targetId:'123'}).actorId,'fish-worker');assert.throws(()=>t.authorize(ticket,{platform:'qq',operation:'dm',targetId:'fish-worker'}));assert.throws(()=>t.authorize(ticket,{platform:'qq',operation:'dm',targetId:'999'}));assert.throws(()=>t.issue({sessionId:'s',requestId:'r',platform:'bili',audience:'dm',channel:'p:123',eventId:'e',actorId:'x'}));const bili=t.issue({sessionId:'b',requestId:'b',platform:'bili',audience:'dm',channel:'bili:dm:123',eventId:'e',actorId:'fish-worker'});state.put('binding','b',{requestId:'b',consumed:true,channel:'bili:dm:123',eventId:'e',actorId:'fish-worker'});assert.equal(t.authorize(bili,{platform:'bili',operation:'dm',targetId:'123'}).targetId,'123');});
