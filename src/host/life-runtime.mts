 function diaryCall(method?: any,sessionId?: any,args: Record<string, any>={}){if(method!=='write'){const c=caller(sessionId);if(c.role!=='diary'||!c.channel?.startsWith('diary:')||!state.list('platform-session').some((r)=>r.key==='evolution.diary'&&r.workspace==='evolution'&&r.sessionId===sessionId))throw Error('Diary contents are internal-only');}const authorized=diaryCaller(sessionId,args);return diary[method]({...args,scope:authorized.scopes[0]},authorized);}function writeDiary(sessionId?: any,args?: any,signal?: any){
