import {randomBytes} from 'node:crypto';
import {platformRoute} from '../core/platforms.mjs';
const validOwnTarget = (row) => row.allowedOwnTarget === 'own-public' ? row.audience === 'public' && row.scope === 'public' && ['bili','douyin','heybox','qzone'].includes(row.platform) : row.allowedOwnTarget === 'own-friends' ? row.platform === 'qzone' && row.audience === 'friends' && row.scope === 'qzone:friends' : false;
export function createReplyTickets({state,now=Date.now,ttlMs=900000}: { state?: any; now?: any; ttlMs?: number; [key: string]: any }){
 function issue(input?: any){if(input.allowedOwnTarget!==undefined&&!validOwnTarget(input))throw Error('Invalid own target');if(!input.sessionId||!input.requestId||!input.platform||!input.channel||!input.eventId)throw Error('Incomplete ticket source');const ticket=randomBytes(32).toString('base64url');let dmTarget;if(input.audience==='dm'){const route=platformRoute(input.channel);if(route.audience!=='dm'||route.platform!==input.platform)throw Error('Invalid DM channel');dmTarget=input.channel.split(':').at(-1);}
 const targetId=input.audience==='dm'?dmTarget:input.channel.startsWith('g:')?input.channel.slice(2):(['public','friends'].includes(input.audience)&&input.sourceTargetId?input.sourceTargetId:input.eventId);if(!targetId)throw Error('Missing source target');state.put('reply-ticket',ticket,{...input,sourceTargetId:targetId,targetId,expiresAt:now()+ttlMs,revoked:false});return ticket;}
 function authorize(ticket?: any,{platform,operation,targetId}: { platform?: any; operation?: any; targetId?: any; [key: string]: any }={}){const row=state.get('reply-ticket',ticket),binding=row&&state.get('binding',row.sessionId);if(!row||row.revoked||row.expiresAt<=now()||row.platform!==platform||!binding?.consumed||binding.requestId!==row.requestId||binding.channel!==row.channel||binding.eventId!==row.eventId||binding.actorId!==row.actorId)throw Error('Invalid reply ticket');if(!operation)throw Error('Operation required');if(row.readOnly&&!['read','status'].includes(operation))throw Error('Browsing ticket is read-only');if(!['read','status'].includes(operation)&&targetId!==row.targetId&&!(targetId===row.allowedOwnTarget&&validOwnTarget(row)))throw Error('Reply target mismatch');return {...row};}
 function revokeForRequest(requestId?: any){for(const row of state.list('reply-ticket'))if(row.requestId===requestId)state.put('reply-ticket',row.id,{...row,revoked:true});}
 return {issue,authorize,revokeForRequest};
}
